# Copy this file to .env (which is git-ignored) and fill in your values.
#
# Dev API URL — used when running in development mode (__DEV__ === true).
# Physical device: use your machine's LAN IP, e.g. http://192.168.1.43:5000/api
# Android emulator: use http://10.0.2.2:5000/api
# iOS simulator:    use http://localhost:5000/api
EXPO_PUBLIC_DEV_API_URL=http://localhost:5000/api

# Prod API URL — used in production / EAS builds.
# Override here if deploying to a different host.
# EXPO_PUBLIC_API_URL=http://185.193.66.50:35555/api
