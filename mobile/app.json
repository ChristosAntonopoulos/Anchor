{
  "expo": {
    "name": "Personal Operating System",
    "slug": "pos-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "scheme": "pos",
    "splash": {
      "image": "./assets/splash-light.png",
      "resizeMode": "cover",
      "backgroundColor": "#151D1B",
      "dark": {
        "image": "./assets/splash-dark.png",
        "backgroundColor": "#151D1B"
      }
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.pos.mobile"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#F6F0E2"
      },
      "package": "com.pos.mobile"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "./plugins/withPersonalAiLauncher.js",
      "expo-router",
      [
        "expo-notifications",
        {
          "sounds": ["./assets/sounds/focus_chime.wav"]
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ]
    ],
    "extra": {
      "apiUrl": "http://localhost:5000/api",
      "router": {},
      "eas": {
        "projectId": "6ffa3cc9-ec45-4359-849a-ea2bc3742d44"
      }
    },
    "owner": "botsyst3m"
  }
}
