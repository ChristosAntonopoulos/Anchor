<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:layout_width="match_parent"
  android:layout_height="wrap_content"
  android:orientation="vertical"
  android:padding="24dp"
  android:background="#171E27">

  <TextView
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:text="Time for a break"
    android:textColor="#E8EDF2"
    android:textSize="20sp"
    android:textStyle="bold" />

  <TextView
    android:id="@+id/remaining"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="12dp"
    android:textColor="#8BB8A8"
    android:textSize="36sp"
    android:textStyle="bold" />

  <TextView
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="8dp"
    android:text="Selected apps are taking a short pause."
    android:textColor="#9EAAB7"
    android:textSize="14sp" />

  <TextView
    android:id="@+id/replacement"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="16dp"
    android:text="Put the phone down and go to your desk."
    android:textColor="#E8EDF2"
    android:textSize="16sp" />

  <Button
    android:id="@+id/btnBackToWork"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="20dp"
    android:text="Back to work"
    android:textAllCaps="false" />

  <Button
    android:id="@+id/btnNeedAccess"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="8dp"
    android:text="I need access"
    android:textAllCaps="false" />

  <Button
    android:id="@+id/btnOpenSettings"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="8dp"
    android:text="Settings"
    android:textAllCaps="false" />
</LinearLayout>
