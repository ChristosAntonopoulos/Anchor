<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:layout_width="match_parent"
  android:layout_height="wrap_content"
  android:orientation="vertical"
  android:padding="24dp"
  android:background="#171E27">

  <TextView
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:text="Ώρα για ένα διάλειμμα"
    android:textColor="#E8EDF2"
    android:textSize="20sp"
    android:textStyle="bold" />

  <TextView
    android:id="@+id/remaining"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="12dp"
    android:textColor="#8BB8A8"
    android:textSize="36sp"
    android:textStyle="bold" />

  <TextView
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="8dp"
    android:text="Τα επιλεγμένα apps κάνουν μια μικρή παύση."
    android:textColor="#9EAAB7"
    android:textSize="14sp" />

  <TextView
    android:id="@+id/replacement"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="16dp"
    android:text="Άσε το κινητό και πήγαινε στο γραφείο."
    android:textColor="#E8EDF2"
    android:textSize="16sp" />

  <Button
    android:id="@+id/btnBackToWork"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="20dp"
    android:text="Επιστροφή στη δουλειά"
    android:textAllCaps="false" />

  <Button
    android:id="@+id/btnNeedAccess"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="8dp"
    android:text="Χρειάζομαι πρόσβαση"
    android:textAllCaps="false" />

  <Button
    android:id="@+id/btnOpenSettings"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="8dp"
    android:text="Ρυθμίσεις"
    android:textAllCaps="false" />
</LinearLayout>
