<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:layout_width="match_parent"
  android:layout_height="wrap_content"
  android:orientation="vertical"
  android:padding="24dp"
  android:background="#171E27">

  <TextView
    android:id="@+id/message"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:text="Το άνοιξες από συνήθεια ή για κάτι συγκεκριμένο;"
    android:textColor="#E8EDF2"
    android:textSize="18sp"
    android:lineSpacingMultiplier="1.2" />

  <TextView
    android:id="@+id/countdown"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="12dp"
    android:textColor="#9EAAB7"
    android:textSize="14sp" />

  <Button
    android:id="@+id/btnReturn"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="20dp"
    android:text="Επιστροφή"
    android:textAllCaps="false" />

  <Button
    android:id="@+id/btnContinue"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="8dp"
    android:text="Συνέχεια"
    android:textAllCaps="false" />

  <Button
    android:id="@+id/btnIntentional"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="8dp"
    android:text="Το χρειάζομαι για κάτι συγκεκριμένο"
    android:textAllCaps="false" />
</LinearLayout>
