<manifest xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:tools="http://schemas.android.com/tools">
  <!-- Special app-ops permission; user must grant via Usage Access settings. -->
  <uses-permission
    android:name="android.permission.PACKAGE_USAGE_STATS"
    tools:ignore="ProtectedPermissions" />
  <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
  <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
  <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

  <!-- Narrow package visibility for default distraction targets. -->
  <queries>
    <package android:name="com.instagram.android" />
    <package android:name="com.google.android.youtube" />
    <intent>
      <action android:name="android.intent.action.MAIN" />
      <category android:name="android.intent.category.LAUNCHER" />
    </intent>
  </queries>

  <application>
    <property
      android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
      android:value="Monitors selected distracting app usage for voluntary Distraction Guard cycles" />

    <service
      android:name=".GuardMonitorService"
      android:exported="false"
      android:foregroundServiceType="specialUse" />

    <activity
      android:name=".OpeningFrictionActivity"
      android:exported="false"
      android:excludeFromRecents="true"
      android:launchMode="singleTop"
      android:taskAffinity=""
      android:theme="@style/Theme.DistractionGuard.Popup" />

    <activity
      android:name=".CooldownActivity"
      android:exported="false"
      android:excludeFromRecents="true"
      android:launchMode="singleTop"
      android:theme="@style/Theme.DistractionGuard.Popup" />

    <receiver
      android:name=".GuardBootReceiver"
      android:exported="true">
      <intent-filter>
        <action android:name="android.intent.action.BOOT_COMPLETED" />
      </intent-filter>
    </receiver>
  </application>
</manifest>
